# Normalise to LF in the repository so a checkout on one platform and a
# checkout on another hash identically. This project makes reproducibility
# claims; letting line endings drift by platform would undercut them.
* text=auto eol=lf

# Binary-ish artifacts that must never be line-ending converted.
*.png binary
*.jpg binary
*.parquet binary
*.safetensors binary
*.gguf binary
